# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Backend
PORT=3001

# Frontend (prefix VITE_ for Vite to expose)
VITE_BACKEND_URL=http://localhost:3001
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# MySQL legacy (OVH) — used by finance import (dual-write)
MYSQL_HOST=sr603743-001.eu.clouddb.ovh.net
MYSQL_PORT=35305
MYSQL_DATABASE=invader
MYSQL_USER=invader
MYSQL_PASSWORD=...

# OpenAI — used by battle question AI generation
OPENAI_API_KEY=sk-...

# Generation d'images produit par IA (back-office > Carte v2 > formulaire produit).
# Tout est optionnel : sans ces variables, les valeurs par defaut ci-dessous s'appliquent.
# OPENAI_IMAGE_MODEL=gpt-image-2      # repli possible : gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium         # low | medium | high (~0,01 / 0,05 / 0,20 EUR par image)
# OPENAI_IMAGE_MAX_PER_DAY=50         # filet anti-emballement, compteur en memoire

# Battle questions import URL (defaults to invader_master public endpoint)
# BATTLE_IMPORT_URL=https://invadermaster-backend-production.up.railway.app/public/battle-questions

# Optional: CORS origins for production (comma-separated)
# CORS_ORIGINS=https://your-app.railway.app

# Bascule automatique des ecrans du bar au lancement / arret d'une session
# (PROJO -> /screen/PROJO, BAR01+BAR02 -> /screen/BAR via l'agent SRV1).
# FRONTEND_PUBLIC_URL=https://invadermaster-frontend-production.up.railway.app
# SCREENS_AUTOSWITCH=0   # pour couper la bascule sans redeployer

# ── Agent du bar (PC serveur SRV1) ───────────────────────────────────
BAR_AGENT_TOKEN=change-me

# Lumieres Philips Hue : ces variables vivent dans agent/.env sur SRV1,
# PAS ici. La cle du bridge ne doit jamais remonter au cloud.
# Voir docs/setup-hue-lights.md
