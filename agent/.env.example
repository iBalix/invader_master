# Connexion au backend
INVADER_MASTER_WS_URL=wss://invadermaster-backend-production.up.railway.app/ws/agent
BAR_AGENT_TOKEN=

# ── Lumieres Philips Hue (voir docs/setup-hue-lights.md) ─────────────
# La cle du bridge reste LOCALE : elle ne remonte jamais au cloud.
HUE_ENABLED=true
HUE_BRIDGE_IP=192.168.1.22
HUE_API_KEY=              # username du bridge : voir hue.txt sur l ancien serveur, NE PAS COMMITER
HUE_DRY_RUN=false
HUE_RATE_GLOBAL=8
HUE_MIN_INTERVAL_MS=250
